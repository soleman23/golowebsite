{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "golo-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "hiw-reference",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3101",
        "--bind",
        "127.0.0.1",
        "--directory",
        "reference"
      ],
      "port": 3101
    },
    {
      "name": "golo-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 3107,
      "env": {
        "PORT": "3107"
      }
    }
  ]
}
