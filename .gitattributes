# Normalize line endings: store text as LF in the repo (Linux deploy target),
# let Git handle the developer's local checkout. Prevents CRLF/LF churn.
* text=auto eol=lf

# Binary assets — never munge.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
