{
  "name": "golo-golf-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "//browserslist": "Modern-only targets, matched to the browsers that support AVIF and CSS image-set (what the backdrops in globals.css rely on). Governs SWC transpilation of app code and autoprefixer. NOTE: this does NOT clear Lighthouse's 'Legacy JavaScript' audit — those polyfills come from next/dist/build/polyfills/polyfill-module.js, which Next injects into the client bundle unconditionally.",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 113",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "^15.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.20",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
