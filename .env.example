# ============================================================================
# GoLo Golf Website — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---------------------------------------------------------------------------
# DATABASE (server-only, REQUIRED)
# Supabase Postgres. Use the POOLED connection string for the app (port 6543,
# pgbouncer) and the DIRECT connection string for migrations (port 5432).
# Get both from: Supabase dashboard -> Project Settings -> Database.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# SMS — "text me the link" (server-only, OPTIONAL)
# Leave blank to run in stub mode: the endpoint still validates + stores the
# number and returns success, but no real text is sent. Fill these in to send
# real SMS via Twilio.
# ---------------------------------------------------------------------------
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# The message body sent to the user. {url} is replaced with the app link.
SMS_MESSAGE_TEMPLATE="Here's your link to download GoLo: {url}"

# ---------------------------------------------------------------------------
# PUBLIC — safe to expose (compiled into the browser bundle)
# App store links for the download buttons. Fall back to #get if unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/idXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_PLAY_URL="https://play.google.com/store/apps/details?id=com.golo.app"

# Canonical site URL, used for SEO metadata / Open Graph tags.
NEXT_PUBLIC_SITE_URL="https://www.golo.golf"

# The download link texted to users (usually a smart link or your site URL).
NEXT_PUBLIC_DOWNLOAD_URL="https://www.golo.golf/get"

# Content flags (default true). Set to "false" to hide a section.
NEXT_PUBLIC_SHOW_STATS="true"
NEXT_PUBLIC_SHOW_TESTIMONIALS="true"

# Hero background image: sunset | course | turf (default sunset).
NEXT_PUBLIC_HERO_BACKDROP="sunset"
