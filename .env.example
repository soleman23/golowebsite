# ============================================================================
# GoLo Golf Website — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---------------------------------------------------------------------------
# DATABASE (server-only, REQUIRED)
# Supabase Postgres. Use the POOLED connection string for the app (port 6543,
# pgbouncer) and the DIRECT connection string for migrations (port 5432).
# Get both from: Supabase dashboard -> Project Settings -> Database.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# SMS — "text me the link" (server-only, OPTIONAL)
# Leave blank to run in stub mode: the endpoint still validates + stores the
# number and returns success, but no real text is sent. Fill these in to send
# real SMS via Twilio.
# ---------------------------------------------------------------------------
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# The message body sent to the user. {url} is replaced with the app link.
SMS_MESSAGE_TEMPLATE="Here's your link to download GoLo: {url}"

# ---------------------------------------------------------------------------
# EMAIL — contact form notification (server-only, OPTIONAL)
# Leave blank to run in stub mode: submissions still save to the database and
# the sender still sees success, but no notification email is sent. Fill in
# RESEND_API_KEY to get emailed via Resend (https://resend.com) when someone
# submits the contact form.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# Inbox that receives the notification. Defaults to info@golo.golf.
CONTACT_NOTIFY_EMAIL="info@golo.golf"
# Sender address Resend sends as. The resend.dev address works without domain
# verification; switch to your own domain once it's verified in Resend.
CONTACT_FROM_EMAIL="GoLo Website <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# NEWSLETTER → HOSTINGER REACH (server-only, OFF by default; #121)
# Off unless REACH_SYNC_ENABLED is exactly "true" AND both values below are
# set. While off, sign-ups save as before and nothing calls Reach. Turn it on
# only after the owner confirms the Reach workspace, plan and limits
# (soleman23/golo#791). Never prefix these with NEXT_PUBLIC_, and never put
# the token in the repo: set it in the server's environment only.
# ---------------------------------------------------------------------------
REACH_SYNC_ENABLED="false"
REACH_API_TOKEN=""
REACH_PROFILE_UUID=""

# ---------------------------------------------------------------------------
# PUBLIC — safe to expose (compiled into the browser bundle)
# App Store link for the download row, read only once siteConfig.iosLive is
# true (until then the slot says "coming soon"). Leave empty until the
# listing is public. The Google Play link is in code (lib/siteConfig.ts);
# NEXT_PUBLIC_GOOGLE_PLAY_URL is no longer read.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_STORE_URL=""
NEXT_PUBLIC_APP_LIVE="false"

# Canonical site URL, used for SEO metadata / Open Graph tags.
NEXT_PUBLIC_SITE_URL="https://www.golo.golf"

# The download link texted to users (usually a smart link or your site URL).
NEXT_PUBLIC_DOWNLOAD_URL="https://www.golo.golf/get"

# Content flags. Stats default on; testimonials default off and stay hidden
# until lib/content holds real, consented quotes.
NEXT_PUBLIC_SHOW_STATS="true"
NEXT_PUBLIC_SHOW_TESTIMONIALS="false"
# /how-it-works video section + hero CTA. Leave off until the recording exists.
NEXT_PUBLIC_SHOW_HIW_VIDEO="false"

# Legal publication gates. Draft routes remain directly reviewable but ship
# noindex/nofollow and stay out of navigation and the sitemap until enabled.
# (The Cookie Policy is always published; it has no gate.)
NEXT_PUBLIC_TERMS_PUBLISHED="false"
NEXT_PUBLIC_ACCEPTABLE_USE_PUBLISHED="false"

# Hero background image: sunset | course | turf (default sunset).
NEXT_PUBLIC_HERO_BACKDROP="sunset"

# Explicit analytics kill switch (GA4). When true, it still needs the
# visitor's explicit opt-in, and Global Privacy Control keeps it off.
NEXT_PUBLIC_ANALYTICS_ENABLED="false"

# Google Analytics 4 measurement ID. Defaults to the live golo.golf property
# (G-36182P0H4D) if unset. The kill switch above must also be enabled.
NEXT_PUBLIC_GA_ID="G-36182P0H4D"

# Microsoft Clarity is off in code (see README "Analytics"). NEXT_PUBLIC_CLARITY_ID
# is no longer read; an old value in an env file or hPanel is ignored.
